rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Signed in, has a profile, and not deactivated/removed by an admin.
    function isActive() {
      return hasProfile()
        && profile().get('disabled', false) != true
        && profile().get('removed', false) != true;
    }

    // An active super admin.
    function isAdmin() {
      return isActive() && profile().role == 'admin';
    }

    // Official super admins that may create their own admin profile once,
    // right after their sign-in is created (scripts/create-admin.js). The
    // email can only be claimed once in Firebase Auth.
    function isBootstrapAdmin(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.auth.token.email in ['offadmin@gmail.com']
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'admin';
    }

    // Only official accounts live in Firebase. The demo accounts are
    // hardcoded in the app and run offline, so they never reach these rules.
    match /users/{uid} {
      allow read: if signedIn();

      // Staff accounts are created by a super admin from the app.
      allow create: if (isAdmin()
                        && request.resource.data.role in
                           ['registry', 'vet', 'clerk', 'inspector', 'disease_control'])
                    || isBootstrapAdmin(uid);

      // A super admin deactivates/removes staff accounts (not other admins).
      allow update: if isAdmin()
                    && resource.data.role != 'admin'
                    && request.resource.data.role != 'admin';

      allow delete: if false;
    }

    // Data collections: any active staff account (signed in, has a profile,
    // not deactivated or removed).
    match /{collection}/{document=**} {
      allow read, write: if collection != 'users' && isActive();
    }
  }
}
